{
  "rendererCases": [
    {
      "name": "accepts the exact renderer handoff coverage",
      "mutation": "none",
      "expectedError": null
    },
    {
      "name": "rejects a stale renderer handoff",
      "mutation": "staleHandoffDigest",
      "expectedError": "stale handoff digest"
    },
    {
      "name": "rejects a missing renderer operation",
      "mutation": "missingOperation",
      "expectedError": "must contain 56 operations"
    },
    {
      "name": "rejects a duplicate renderer operation",
      "mutation": "duplicateOperation",
      "expectedError": "duplicate operation"
    },
    {
      "name": "rejects a missing renderer tab",
      "mutation": "missingTab",
      "expectedError": "missing required sample tabs"
    },
    {
      "name": "rejects a noncanonical renderer tab",
      "mutation": "noncanonicalTab",
      "expectedError": "missing the canonical"
    },
    {
      "name": "rejects renderer source-hash drift",
      "mutation": "sourceHashDrift",
      "expectedError": "source-hash mismatch"
    },
    {
      "name": "rejects a noncanonical renderer payload",
      "mutation": "noncanonicalPayload",
      "expectedError": "canonical JSON bytes"
    },
    {
      "name": "rejects a renderer handoff sidecar mismatch",
      "mutation": "sidecarMismatch",
      "expectedError": "sidecar mismatch"
    }
  ],
  "webhookCases": [
    {
      "name": "accepts byte-exact cross-implementation webhook evidence",
      "mutation": "none",
      "expectedError": null
    },
    {
      "name": "rejects a stale captured-manifest sidecar",
      "mutation": "staleManifestSidecar",
      "expectedError": "Captured manifest sidecar mismatch"
    },
    {
      "name": "rejects a captured manifest against an altered schema",
      "mutation": "invalidManifestSchema",
      "expectedError": "schema must require"
    },
    {
      "name": "rejects a stale capture digest",
      "mutation": "staleCaptureDigest",
      "expectedError": "captureSha256 mismatch"
    },
    {
      "name": "rejects a stale key digest",
      "mutation": "staleKeyDigest",
      "expectedError": "keySha256 mismatch"
    },
    {
      "name": "rejects a stale server revision",
      "mutation": "staleServerCommit",
      "expectedError": "stale serverCommit"
    },
    {
      "name": "rejects a substituted whole-report server revision",
      "mutation": "substitutedServerCommit",
      "expectedError": "stale serverCommit"
    },
    {
      "name": "rejects swapped resource keys",
      "mutation": "swappedKeys",
      "expectedError": "signing key digest mismatch"
    },
    {
      "name": "rejects missing body fixtures",
      "mutation": "missingFixture",
      "expectedError": "body fixture is missing"
    },
    {
      "name": "rejects altered exact signed headers",
      "mutation": "alteredHeader",
      "expectedError": "webhookId mismatch"
    },
    {
      "name": "rejects altered raw body bytes",
      "mutation": "alteredBody",
      "expectedError": "raw body digest mismatch"
    },
    {
      "name": "rejects an unreproducible signature",
      "mutation": "signatureMismatch",
      "expectedError": "signature mismatch"
    },
    {
      "name": "rejects an independently mismatched header digest",
      "mutation": "headerDigestMismatch",
      "expectedError": "signed header record digest mismatch"
    },
    {
      "name": "rejects a manifest expected-result mismatch",
      "mutation": "manifestExpectedResultMismatch",
      "expectedError": "expectedResult does not match the captured manifest"
    },
    {
      "name": "rejects a Go actual-result mismatch",
      "mutation": "goActualResultMismatch",
      "expectedError": "actualResult does not match expectedResult"
    },
    {
      "name": "rejects a Go and TypeScript result mismatch",
      "mutation": "typescriptResultMismatch",
      "expectedError": "Go and TypeScript results do not match"
    },
    {
      "name": "rejects an incomplete Go attestation",
      "mutation": "missingGoRow",
      "expectedError": "must contain 2 fixture rows"
    },
    {
      "name": "rejects a noncanonical Go payload",
      "mutation": "noncanonicalPayload",
      "expectedError": "canonical JSON bytes"
    }
  ]
}
