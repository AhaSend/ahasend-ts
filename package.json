{
  "name": "@ahasend/sdk",
  "version": "0.1.0",
  "description": "Official Node.js TypeScript SDK for the AhaSend transactional email API.",
  "keywords": [
    "ahasend",
    "email",
    "transactional",
    "sdk",
    "typescript",
    "smtp",
    "webhooks"
  ],
  "homepage": "https://ahasend.com",
  "bugs": {
    "url": "https://github.com/AhaSend/ahasend-ts/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AhaSend/ahasend-ts.git"
  },
  "license": "MIT",
  "author": "AhaSend",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./webhooks": {
      "import": {
        "types": "./dist/webhooks/index.d.ts",
        "default": "./dist/webhooks/index.js"
      },
      "require": {
        "types": "./dist/webhooks/index.d.cts",
        "default": "./dist/webhooks/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.tests.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --exclude 'tests/integration/**'",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "contracts:generate": "node scripts/generate-contracts.mjs",
    "contracts:check": "node scripts/generate-contracts.mjs --check",
    "sdk:generate": "node scripts/generate-sdk.mjs",
    "sdk:check": "node scripts/generate-sdk.mjs --check",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run clean && npm run contracts:check && npm run sdk:check && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^3.2.6",
    "ajv": "^6.14.0",
    "eslint": "^9.0.0",
    "express": "5.2.1",
    "js-yaml": "4.1.1",
    "prettier": "3.8.3",
    "rimraf": "^6.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.6"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false
}
