{
  "name": "@ahasend/sdk",
  "version": "0.1.0",
  "description": "Official Node.js TypeScript SDK for the AhaSend transactional email API.",
  "keywords": [
    "ahasend",
    "email",
    "transactional",
    "sdk",
    "typescript",
    "smtp",
    "webhooks"
  ],
  "homepage": "https://ahasend.com",
  "bugs": {
    "url": "https://github.com/AhaSend/ahasend-ts/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AhaSend/ahasend-ts.git"
  },
  "license": "MIT",
  "author": "AhaSend",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./webhooks": {
      "import": {
        "types": "./dist/webhooks/index.d.ts",
        "default": "./dist/webhooks/index.js"
      },
      "require": {
        "types": "./dist/webhooks/index.d.cts",
        "default": "./dist/webhooks/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "ci": "npm run typecheck && npm run lint && npm test && npm run verify:audit && npm run test:package:preflight",
    "dev": "tsup --watch",
    "verify:audit": "node scripts/verify-audit.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "test:package:tarball": "npm run verify:package",
    "test:package:preflight": "npm run build && node scripts/create-preflight-pack.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.tests.json",
    "test": "npm run test:policy && vitest run --exclude 'tests/test-policy.test.ts'",
    "test:watch": "vitest",
    "test:policy": "vitest run tests/test-policy.test.ts",
    "test:unit": "npm run test:policy && vitest run --exclude 'tests/integration/**' --exclude 'tests/test-policy.test.ts'",
    "test:integration": "npm run test:integration:preflight",
    "test:integration:tarball": "vitest run --config vitest.integration.config.ts",
    "test:integration:preflight": "npm run test:package:preflight",
    "test:coverage": "npm run test:policy && vitest run --coverage --exclude 'tests/test-policy.test.ts'",
    "contracts:generate": "node scripts/generate-contracts.mjs",
    "contracts:check": "node scripts/generate-contracts.mjs --check",
    "sdk:generate": "node scripts/generate-sdk.mjs",
    "sdk:check": "node scripts/generate-sdk.mjs --check",
    "docs:generate": "node scripts/generate-docs.mjs",
    "docs:check": "node scripts/generate-docs.mjs --check",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run clean && npm run contracts:check && npm run sdk:check && npm run verify:audit && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@microsoft/api-extractor": "7.58.10",
    "@stoplight/prism-cli": "5.14.2",
    "@types/express": "5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^3.2.6",
    "ajv": "^6.14.0",
    "eslint": "^9.0.0",
    "express": "5.2.1",
    "js-yaml": "4.1.1",
    "prettier": "3.8.3",
    "publint": "0.3.21",
    "rimraf": "^6.0.0",
    "tsup": "^8.3.0",
    "typescript": "5.6.3",
    "typescript-current": "npm:typescript@7.0.2",
    "vitest": "^3.2.6"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false
}
